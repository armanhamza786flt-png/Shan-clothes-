
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f5f5f5;
}

header{
    background:#111;
    color:#d4af37;
    text-align:center;
    padding:35px;
}

header p{
    color:white;
}

nav{
    background:#222;
    text-align:center;
    padding:15px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:20px;
}

.hero{
    text-align:center;
    padding:70px 20px;
    background:white;
}

.hero h2{
    font-size:42px;
    color:#111;
}

.hero p{
    margin:20px;
    font-size:18px;
}

button{
    background:#d4af37;
    color:white;
    padding:14px 35px;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

.collection{
    display:flex;
    justify-content:center;
    gap:25px;
    padding:40px;
}

.box{
    background:white;
    width:280px;
    padding:30px;
    text-align:center;
    box-shadow:0 5px 15px #ccc;
}

footer{
    background:#111;
    color:white;
    text-align:center;
    padding:20px;
}
